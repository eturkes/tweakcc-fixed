{
  "schemaVersion": 1,
  "id": "native-grep-visible-evidence-v1",
  "corpus": {
    "repository": "https://github.com/skrabe/tweakcc-fixed",
    "revision": "85ae46fe322de92aa909dadc28847556a6d53a63"
  },
  "selection": {
    "method": "Ten public repository behavior investigations selected before native Grep implementation, across independent subsystems. Fixed literal/regex queries were authored from the questions and source. Synthetic counterexamples are reported separately.",
    "notMeasured": [
      "speed",
      "semantic symbol resolution",
      "representative model-quality effect size",
      "private session history"
    ]
  },
  "policy": {
    "byteBudgets": [2048, 8192],
    "budgetUnit": "UTF-8 bytes of visible result text per fixed query",
    "instructions": "Answer the question using only the supplied search results. Cite repository paths and line numbers. Distinguish implementation from tests and examples. Report missing evidence or uncertainty; do not infer completeness from a truncated search. Include every requested constraint and counterexample.",
    "queryPolicy": "Same fixed query, scope, context, result budget, and instructions for each condition. Native raw rg has deterministic path order, with no candidate ranking. Report each task and budget separately; do not collapse results into a marketing aggregate."
  },
  "tasks": [
    {
      "id": "release-prompt-source",
      "corpus": "repository",
      "question": "For an installed package, where do prompt JSONs come from, how is the cache separated by release, and does a newer Claude Code version bypass the support check? Explain the checkout exception and identify regression coverage.",
      "queries": [
        {
          "pattern": "downloadStringsFile|TWEAKCC_SUPPORTED_CC",
          "path": "src",
          "context": 0
        },
        {
          "pattern": "refs/tags|cacheDir|newer requested version|repo-local prompts",
          "path": "src",
          "context": 0
        }
      ],
      "requiredEvidence": [
        {
          "id": "release-tag",
          "path": "src/systemPromptDownload.ts",
          "line": 189,
          "snippet": "refs/tags/v${TWEAKCC_VERSION}/data/prompts/"
        },
        {
          "id": "release-cache",
          "path": "src/systemPromptDownload.ts",
          "line": 161,
          "snippet": "const cacheDir = path.join(PROMPT_CACHE_DIR, `v${TWEAKCC_VERSION}`);"
        },
        {
          "id": "release-reject-test",
          "path": "src/systemPromptDownload.test.ts",
          "line": 188,
          "snippet": "rejects a newer requested version before cache or fetch"
        },
        {
          "id": "release-local-test",
          "path": "src/systemPromptDownload.test.ts",
          "line": 159,
          "snippet": "uses repo-local prompts before checking the supported version"
        },
        {
          "id": "release-meta",
          "path": "src/packageMeta.ts",
          "line": 25,
          "snippet": "PACKAGE_META.supportedClaudeCode"
        }
      ],
      "expectedAnswerFacts": [
        {
          "id": "release-prompt-source-fact-1",
          "text": "Network reads use the package release tag, not the main branch; cache paths include the package release version.",
          "evidenceIds": ["release-tag", "release-cache"]
        },
        {
          "id": "release-prompt-source-fact-2",
          "text": "Newer requested versions fail before cache or network, but a checkout-local prompts file is used first.",
          "evidenceIds": ["release-reject-test", "release-local-test"]
        },
        {
          "id": "release-prompt-source-fact-3",
          "text": "The supported Claude Code bound comes from package metadata.",
          "evidenceIds": ["release-meta"]
        }
      ]
    },
    {
      "id": "config-location-precedence",
      "corpus": "repository",
      "question": "Which configuration directory wins when the explicit override, legacy directory, Claude-aligned directory, and XDG location coexist? Explain whitespace and tilde handling and find the tests covering precedence.",
      "queries": [
        {
          "pattern": "getConfigDir|TWEAKCC_CONFIG_DIR|XDG_CONFIG_HOME",
          "path": "src",
          "context": 0
        },
        {
          "pattern": "highest priority|prioritize TWEAKCC_CONFIG_DIR|prefer.*XDG",
          "path": "src",
          "context": 0
        }
      ],
      "requiredEvidence": [
        {
          "id": "config-trim",
          "path": "src/config.ts",
          "line": 45,
          "snippet": "process.env.TWEAKCC_CONFIG_DIR?.trim()"
        },
        {
          "id": "config-tilde",
          "path": "src/config.ts",
          "line": 47,
          "snippet": "return expandTilde(tweakccConfigDir);"
        },
        {
          "id": "config-explicit-test",
          "path": "src/tests/tweakccConfigDir.test.ts",
          "line": 90,
          "snippet": "prioritize TWEAKCC_CONFIG_DIR over all other locations"
        },
        {
          "id": "config-claude-test",
          "path": "src/tests/tweakccConfigDir.test.ts",
          "line": 114,
          "snippet": "prefer ~/.claude/tweakcc over XDG_CONFIG_HOME"
        },
        {
          "id": "config-legacy-test",
          "path": "src/tests/xdgConfigHome.test.ts",
          "line": 44,
          "snippet": "should use ~/.tweakcc when it exists, even if XDG_CONFIG_HOME is set"
        }
      ],
      "expectedAnswerFacts": [
        {
          "id": "config-location-precedence-fact-1",
          "text": "A nonempty trimmed explicit override wins, with tilde expansion.",
          "evidenceIds": ["config-trim", "config-tilde"]
        },
        {
          "id": "config-location-precedence-fact-2",
          "text": "Then precedence is existing ~/.tweakcc, existing ~/.claude/tweakcc, XDG_CONFIG_HOME/tweakcc, then ~/.tweakcc.",
          "evidenceIds": [
            "config-explicit-test",
            "config-claude-test",
            "config-legacy-test"
          ]
        }
      ]
